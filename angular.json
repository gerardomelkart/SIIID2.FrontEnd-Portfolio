{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json", "version": 1,
  "projects": {"portfolio": {
    "projectType": "application", "root": "", "sourceRoot": "src",
    "architect": {
      "build": {"builder": "@angular/build:application", "options": {
        "browser": "src/main.ts", "index": "src/index.html", "tsConfig": "tsconfig.json",
        "styles": ["src/styles.css"], "outputPath": "dist/portfolio",
        "budgets": [{"type": "initial", "maximumWarning": "600kB", "maximumError": "800kB"}]
      }},
      "serve": {"builder": "@angular/build:dev-server", "options": {"buildTarget": "portfolio:build", "proxyConfig": "proxy.conf.json"}}
    }
  }}
}
